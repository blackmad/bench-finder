// 301s the old host (bench.blackmad.com) and www.benchfinder.nl to https://benchfinder.nl,
// keeping path and query so old /bench/<id> links still land. Deploy: cd redirect && npx wrangler deploy
{
  "name": "bench-finder-redirect",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "www.benchfinder.nl", "custom_domain": true }
  ]
}
