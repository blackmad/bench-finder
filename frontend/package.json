{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:biome": "biome lint .",
    "lint:hooks": "biome lint . --only=correctness/useHookAtTopLevel --only=correctness/useExhaustiveDependencies",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "preview": "vite preview",
    "generate-api": "npx openapi-typescript-codegen --input http://localhost:8866/openapi.json --output ./src/api --client axios --name BenchFinderApi --useOptions",
    "generate-api:local": "npx openapi-typescript-codegen --input ../openapi.json --output ./src/api --client axios --name BenchFinderApi --useOptions",
    "dev:fast": "npm run dev",
    "dev:full": "concurrently \"cd .. && source venv/bin/activate && uvicorn fastapi_server:app --reload --port 8866\" \"npm run dev\"",
    "prepare": "cd .. && husky frontend/.husky || true"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "@types/leaflet": "^1.9.20",
    "@types/styled-components": "^5.1.34",
    "axios": "^1.12.2",
    "framer-motion": "^12.23.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-intersection-observer": "^9.16.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.3",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.3",
    "openapi-typescript-codegen": "^0.29.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "biome check --write",
      "eslint --fix"
    ],
    "**/*.{ts,tsx,js,jsx,json,md}": [
      "biome format --write"
    ]
  }
}