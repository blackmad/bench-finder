{
    "version": 2,
    "buildCommand": "cd frontend && npm run build",
    "installCommand": "cd frontend && npm install && uv pip install -r api/requirements.txt",
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "frontend/dist"
            }
        },
        {
            "src": "api/index.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.py"
        },
        {
            "src": "/images/(.*)",
            "dest": "/api/index.py"
        },
        {
            "src": "/docs(.*)",
            "dest": "/api/index.py"
        },
        {
            "src": "/redoc(.*)",
            "dest": "/api/index.py"
        },
        {
            "src": "/openapi.json",
            "dest": "/api/index.py"
        },
        {
            "src": "/health",
            "dest": "/api/index.py"
        },
        {
            "src": "/assets/(.*)",
            "dest": "/frontend/dist/assets/$1"
        },
        {
            "src": "/(.*\\.(ico|png|jpg|jpeg|svg|gif|webp|woff|woff2|ttf|eot))",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            },
            "dest": "/frontend/dist/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/frontend/dist/index.html"
        }
    ],
    "env": {
        "PYTHONPATH": "."
    }
}
