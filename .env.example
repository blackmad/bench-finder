# Copy this file to .env and fill in your API keys

# Google Maps API Key (for Geocoding and Street View)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Roboflow API Key
ROBOFLOW_API_KEY=your_roboflow_api_key_here

# Firebase Configuration (for auth, storage, and database)
# Get these from Firebase Console > Project Settings > General
FIREBASE_CREDENTIALS_PATH=path/to/firebase_creds.json
# Or use base64-encoded credentials (for serverless deployments)
# FIREBASE_CREDENTIALS_BASE64=base64_encoded_credentials_json

# Firebase Storage
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_STORAGE_PREFIX=images
# FIREBASE_HOSTING_URL=https://your-project.web.app

# Frontend Firebase Config (for Vite - prefix with VITE_)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Database (Cloud SQL PostgreSQL)
# For local development with SQLite, leave empty or set DATABASE_PATH
DATABASE_PATH=data/benches.db
# For Cloud SQL PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/database

# Cloud SQL Instance (for automatic IP allowlisting during migration)
# CLOUDSQL_INSTANCE=your-instance-name
# GCP_PROJECT=your-project-id
