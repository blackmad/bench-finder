// Bench Finder write API. Local dev needs none of the TODOs below (miniflare simulates D1/R2).
{
  "name": "bench-finder-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "FIREBASE_PROJECT_ID": "bench-finder-a45db",
    // Error reports to Sentry project whizziwig/bench-finder-worker (a public key).
    "SENTRY_DSN": "https://cc4c36278c6ae7a6f2637474082cabfe@o417464.ingest.us.sentry.io/4512443395735552",
    // Deployed Pages origins, comma-separated. http://localhost:5173 is always allowed.
    "ALLOWED_ORIGINS": "https://bench.blackmad.com,https://bench-finder.bench-finder-worker.workers.dev",
    // TODO(owner): comma-separated Firebase uids of moderators (find yours via GET /api/me after signing in).
    "ADMIN_UIDS": "wT3SX9wCFfXBRgKohcUbtKZAJK43"
  },
  // Secret, not a var: `npx wrangler secret put TURNSTILE_SECRET` (see README).

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bench-finder",
      "database_id": "84e11cf2-9303-42ae-82d0-6b42c2cd82e8",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      // Private bucket for user report photos.
      "bucket_name": "bench-finder-uploads"
    }
  ]
}
